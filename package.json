{
  "name": "@portabletext/to-html",
  "version": "6.0.0",
  "description": "Render Portable Text to HTML",
  "keywords": [
    "portable-text"
  ],
  "homepage": "https://github.com/portabletext/to-html#readme",
  "bugs": {
    "url": "https://github.com/portabletext/to-html/issues"
  },
  "license": "MIT",
  "author": "Sanity.io <hello@sanity.io>",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/portabletext/to-html.git"
  },
  "files": [
    "dist",
    "!dist/stats.html"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.js",
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "tsdown",
    "coverage": "vitest run --coverage",
    "docs:build": "typedoc",
    "format": "oxfmt .",
    "lint": "oxlint --type-aware --type-check --deny-warnings --report-unused-disable-directives",
    "prepublishOnly": "pnpm build",
    "release": "changeset publish",
    "test": "vitest run"
  },
  "dependencies": {
    "@portabletext/toolkit": "^6.0.0",
    "@portabletext/types": "^4.0.2"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^2.31.1",
    "@sanity/tsconfig": "^2.2.1",
    "@sanity/tsdown-config": "^0.23.0",
    "@vitest/coverage-v8": "^4.1.10",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "oxlint-tsgolint": "^7.0.2001",
    "tsdown": "^0.22.14",
    "typedoc": "^0.28.20",
    "typescript": "6.0.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "pnpm@11.18.0"
}
