{
  "name": "@portabletext/to-html",
  "version": "6.0.0",
  "description": "Render Portable Text to HTML",
  "keywords": [
    "html",
    "portable-text"
  ],
  "homepage": "https://github.com/portabletext/to-html#readme",
  "bugs": {
    "url": "https://github.com/portabletext/to-html/issues"
  },
  "license": "MIT",
  "author": "Sanity.io <hello@sanity.io>",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/portabletext/to-html.git"
  },
  "files": [
    "dist",
    "!dist/stats.html"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.js",
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "tsdown",
    "coverage": "vitest run --coverage",
    "docs:build": "typedoc",
    "format": "oxfmt .",
    "lint": "oxlint --type-aware --type-check --deny-warnings --report-unused-disable-directives",
    "prepublishOnly": "pnpm build",
    "release": "changeset publish",
    "test": "vitest run",
    "typegen": "(cd test/typegen && sanity schema extract && sanity typegen generate)"
  },
  "dependencies": {
    "@portabletext/toolkit": "^6.1.0",
    "@portabletext/types": "^4.0.2"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@sanity/client": "^8.17.0",
    "@sanity/image-url": "^2.2.0",
    "@sanity/tsconfig": "^2.2.1",
    "@sanity/tsdown-config": "^0.33.0",
    "@vitest/coverage-v8": "^5.1.1",
    "groq": "^6.25.0",
    "oxfmt": "^0.80.0",
    "oxlint": "^1.95.0",
    "oxlint-tsgolint": "^7.0.2008",
    "sanity": "^6.25.0",
    "tsdown": "^0.23.7",
    "typedoc": "^0.28.20",
    "typescript": "6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "pnpm@12.23.0"
}
